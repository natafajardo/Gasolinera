# Copiar este fichero como .env y sustituir los valores por contraseñas locales.
# .env está excluido del control de versiones.
MYSQL_DATABASE=gasolinera
MYSQL_USER=gasolinera_app
MYSQL_PASSWORD=cambiar_esta_password
MYSQL_ROOT_PASSWORD=cambiar_esta_password_root
MYSQL_PORT=3306
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=cambiar_esta_password_pgadmin
PGADMIN_PORT=5050
